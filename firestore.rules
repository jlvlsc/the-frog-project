rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Updates history: public read
    match /updates/{updateId} {
      allow read: if true;

      // Admin writes/deletes only when authenticated as the fixed admin UID.
      // Client must sign in using the custom token minted by mintAdminToken.
      allow create, update, delete: if request.auth != null && request.auth.uid == 'updates-admin';
    }

    // Compliance codex overrides: keeper edits via admin console (same UID gate
    // as updates). NOTE: the console talks to the archfrogunified Firestore —
    // paste this same block into that project's rules in the Firebase console.
    match /codexOverrides/{fileId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && (request.auth.uid == 'updates-admin' || request.auth.token.admin == true);
    }

    // Everything else locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

